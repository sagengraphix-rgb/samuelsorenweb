rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserEmail() {
      return request.auth.token.email;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserEmail() == 'sorensam84@gmail.com' ||
        getUserEmail() == 'sorensam@gmail.com' ||
        getUserEmail() == 'sagengraphix@gmail.com' ||
        getUserEmail() == 'admin@samuelsoren.org' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }
    
    function isEditor() {
      return isAuthenticated() && (
        getUserEmail() == 'editor@samuelsoren.org' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor')
      );
    }
    
    function isStaff() {
      return isSuperAdmin() || isEditor();
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Public collections (blogs, ministries, products, settings)
    match /blogs/{blogId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if isStaff();
    }

    match /ministries/{ministryId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if isStaff();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow write: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Contact Submissions & Prayer Requests - STRICTLY PRIVATE ADMIN ONLY
    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'message', 'category'])
                    && request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 5;
      allow read, update, delete: if isSuperAdmin();
    }

    // Donations & Tithes - Created by public donors, managed by SuperAdmin
    match /donations/{donationId} {
      allow create: if request.resource.data.keys().hasAll(['donorName', 'email', 'cause', 'amount', 'paymentMethod'])
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
      allow read, update, delete: if isSuperAdmin();
    }

    // Newsletter Subscribers
    match /newsletterSubscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasAll(['email'])
                    && request.resource.data.email is string;
      allow read, delete: if isSuperAdmin();
      allow update: if false;
    }

    // Orders & Payment Records
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['customerName', 'email', 'total'])
                    && request.resource.data.total is number;
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    // User Accounts
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Admin authorization records
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
